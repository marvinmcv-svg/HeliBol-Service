{
  "ci": {
    "collect": {
      "startServerCommand": "pnpm start -p 3200",
      "startServerReadyPattern": "Ready",
      "url": [
        "http://localhost:3200/es",
        "http://localhost:3200/es/servicios/rescate-y-medevac",
        "http://localhost:3200/es/flota/bell-412"
      ],
      "numberOfRuns": 3,
      "settings": { "preset": "perf", "formFactor": "mobile", "chromeFlags": "--no-sandbox --headless=new" }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["warn", { "minScore": 0.9 }],
        "categories:accessibility": ["error", { "minScore": 0.9 }],
        "categories:best-practices": ["error", { "minScore": 0.9 }],
        "categories:seo": ["warn", { "minScore": 0.9 }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.05 }]
      }
    },
    "upload": { "target": "temporary-public-storage" }
  }
}
