# Server-only. Never prefix these with NEXT_PUBLIC_.
ANTHROPIC_API_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=
# Sender must be on a domain verified in Resend, e.g. "Helibol <no-reply@helibol.com>"
RESEND_FROM=
LEAD_INBOX=info@helibol.com
# International format, digits only. Defaults to 59177165787 when unset.
NEXT_PUBLIC_HELIBOL_WHATSAPP=
# Optional — rate limiting for Heli (falls back to in-memory if unset)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Public
NEXT_PUBLIC_SITE_URL=https://helibol.com
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=
# Show testimonials section once real quotes exist (plan §6.10)
NEXT_PUBLIC_SHOW_TESTIMONIALS=false
